# Development Compose configuration. init_docker_env.py creates random local secrets.
DJANGO_SECRET_KEY=GENERATE_DJANGO_SECRET
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
POSTGRES_DB=defiant_studio
POSTGRES_USER=defiant
APP_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional live provider/store bindings; values stay in your untracked .env.
DEFIANT_IMAGE_API_KEY=
SHOPIFY_INFATUATION_TOKEN=
COMFYUI_API_KEY=
COMFYUI_ALLOWED_HOSTS=
