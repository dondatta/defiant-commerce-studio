# Load exported variables before starting all three processes. Django does not load this file automatically.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Required for a production deployment, generated securely outside this repository:
DJANGO_SECRET_KEY=
# Set secret values through your environment/secret manager, never through a committed file.
DEFIANT_IMAGE_API_KEY=
# Each store/provider can use its own binding name configured in Brand settings:
SHOPIFY_INFATUATION_TOKEN=
COMFYUI_API_KEY=
# Allow private ComfyUI connections only for explicitly trusted hosts:
COMFYUI_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional PostgreSQL. Omit POSTGRES_DB for development SQLite:
# POSTGRES_DB=defiant_studio
# POSTGRES_USER=defiant
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Optional private S3 storage (AWS authentication uses the normal SDK chain):
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# PRIVATE_STORAGE_ROOT=/absolute/private/path
